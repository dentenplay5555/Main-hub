{
  "name": "music-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 3001",
    "typecheck": "tsc --noEmit",
    "d1:migrate:local": "wrangler d1 migrations apply qr-music-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply qr-music-db --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@qr-music/shared": "*",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "~5.9.0",
    "wrangler": "^4.135.0"
  }
}
