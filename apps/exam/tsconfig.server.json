{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true
  },
  "include": [
    "functions/**/*.ts",
    "server/**/*.ts",
    "src/types/index.ts"
  ],
  "exclude": [
    "server/**/*.test.ts"
  ]
}
